# Optional approved browser-facing MapTiler configuration.
# Leave either value blank to use the checked-in provider-neutral fallback.
# Use an origin-restricted browser key in .env.local. Never commit a real key.
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAP_STYLE_URL=

# Server-only OpenAI credential for Ask AI and the bounded Candidate Review Agent.
# Store the real value in .env.local or the deployment secret manager.
OPENAI_API_KEY=

# Governed local evidence snapshot paths (server-only).
EVIDENCE_SNAPSHOT_DIR=data/approved/snowflake/2026-08-11
NORMALIZED_MARKET_DATA_DIR=.local-data/normalized-market-data
CLINIC_MARKET_SNAPSHOT_DIR=.local-data/clinic-market-snapshot
DUCKDB_PATH=.local/evidence-snapshot.duckdb
EVIDENCE_SOURCE_DIR=
SNOWFLAKE_SNAPSHOT_VERSION=approved-snowflake-2026-08-11-v1
